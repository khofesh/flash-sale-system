# Reference for every setting, with the values `pnpm dev` expects. Nothing loads this
# file automatically: `set -a; . ./.env; set +a` exports a copy into your shell. The
# compose stack sets its own connection URLs and defaults PAYMENT_FAILURE_RATE and
# SHIPPING_FAILURE_RATE to 0, so `e2e` and the stress runs are deterministic.

# Shared
NODE_ENV=production
LOG_LEVEL=info
# Log field; compose sets it per service.
# SERVICE_NAME=api

# API
HOST=0.0.0.0
PORT=3000

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://flash:flash@localhost:5432/flash
PG_POOL_MAX=20
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Phase 5 throughput
# nginx per-client-IP limit. `pnpm stress` raises it for the duration of a run.
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
# How long an API replica answers 410 from memory after the script says SOLD_OUT.
SOLD_OUT_RECHECK_MS=1000
PAYMENT_CONCURRENCY=50
SHIPPING_CONCURRENCY=50

# Phase 3 saga (payment and shipping mocks)
PAYMENT_LATENCY_MS=200
PAYMENT_FAILURE_RATE=0.1
PAYMENT_TIMEOUT_MS=60000
SHIPPING_LATENCY_MS=100
SHIPPING_FAILURE_RATE=0.02

# Sale (Phase 1). Times are ISO 8601; when omitted the first boot creates a sale
# starting in 60 s and ending 30 minutes later, which is then persisted.
SALE_ID=launch-2026
SALE_PRODUCT_ID=flash-tshirt
SALE_STARTS_AT=
SALE_ENDS_AT=
SALE_TOTAL_STOCK=100
# Unset disables the /admin routes. Compose defaults it to dev-admin-token.
ADMIN_TOKEN=dev-admin-token

# Migrations job. Defaults to infra/migrations.
# MIGRATIONS_DIR=

# Test tooling (pnpm e2e, pnpm stress, pnpm chaos)
# E2E_BASE_URL=http://localhost:8080
# How the k6 container reaches the stack. Setting it leaves nginx's rate limit alone.
# BASE_URL=http://host.docker.internal:8080
# METRICS_URL=http://localhost:8080/metrics
# Scenario overrides; each scenario has its own defaults.
# RATE=
# DURATION=
# ITERATIONS=
# VUS=
# MIN_RPS=
# MAX_P99_MS=
# CHAOS_KILL_AFTER_S=0.5
