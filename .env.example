# Shared
NODE_ENV=production
LOG_LEVEL=info

# API
HOST=0.0.0.0
PORT=3000

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://flash:flash@localhost:5432/flash
PG_POOL_MAX=20
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Phase 5 throughput
# nginx per-client-IP limit; high enough for the 5k req/s spike from one host.
RATE_LIMIT_RPS=20000
RATE_LIMIT_BURST=10000
# How long an API replica answers 410 from memory after the script says SOLD_OUT.
SOLD_OUT_RECHECK_MS=1000
PAYMENT_CONCURRENCY=50
SHIPPING_CONCURRENCY=50

# Phase 3 saga (payment and shipping mocks)
PAYMENT_LATENCY_MS=200
PAYMENT_FAILURE_RATE=0.1
PAYMENT_TIMEOUT_MS=60000
SHIPPING_LATENCY_MS=100
SHIPPING_FAILURE_RATE=0.02

# Sale (Phase 1). Times are ISO 8601; when omitted the first boot creates a sale
# starting in 60 s and ending 30 minutes later, which is then persisted.
SALE_ID=launch-2026
SALE_PRODUCT_ID=flash-tshirt
SALE_STARTS_AT=
SALE_ENDS_AT=
SALE_TOTAL_STOCK=100
ADMIN_TOKEN=dev-admin-token
