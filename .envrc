# Docker works as is. Rootless Podman is used when its socket exists and DOCKER_HOST is unset.
if [ -z "${DOCKER_HOST:-}" ]; then
  podman_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
  if [ -S "$podman_socket" ]; then
    export DOCKER_HOST="unix://$podman_socket"
  fi
  unset podman_socket
fi
# Engine socket mounted into Floci (web console). On Linux it is the socket DOCKER_HOST
# points at; Docker Desktop and Podman machine on macOS expose /var/run/docker.sock.
if [ -z "${CONTAINER_SOCKET:-}" ]; then
  case "$(uname -s):${DOCKER_HOST:-}" in
    Linux:unix://*) CONTAINER_SOCKET="${DOCKER_HOST#unix://}" ;;
    *) CONTAINER_SOCKET=/var/run/docker.sock ;;
  esac
  export CONTAINER_SOCKET
fi
# Ryuk (Testcontainers' reaper) mounts the socket; under SELinux it must run
# privileged. Rootless, so that is still only this user's privileges.
export TESTCONTAINERS_RYUK_PRIVILEGED="${TESTCONTAINERS_RYUK_PRIVILEGED:-true}"
